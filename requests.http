@baseUrl = http://localhost:3000

### Login
# @name loginRequest
POST {{baseUrl}}/login
Content-Type: application/json

{
    "username": "admin",
    "password": "password123"
}

### Try to GET todos WITHOUT a token
GET {{baseUrl}}/todos

### GET todos WITH the Access Token
GET {{baseUrl}}/todos
Authorization: Bearer {{loginRequest.response.body.accessToken}}

### CREATE a new todo
POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{loginRequest.response.body.accessToken}}

{
    "title": "Learn JWT Aurh",
    "state": "doing"
}

### REFRESH the Access Token
POST {{baseUrl}}/refresh

### LOGOUT
POST {{baseUrl}}/logout

### TRY to REFRESH after logout
POST {{baseUrl}}/refresh

### TEST Rate Limiting
POST {{baseUrl}}/login
Content-Type: application/json

{
    "username": "hacker",
    "password": "wrongpassword"
}